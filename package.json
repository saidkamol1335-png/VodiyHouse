{
  "name": "vodiyhouse",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:site": "npm run dev -w @vh/site",
    "dev:admin": "npm run dev -w @vh/admin",
    "build:site": "npm run build -w @vh/site",
    "build:admin": "npm run build -w @vh/admin",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "mockup:serve": "node docs/mockup/tools/serve.mjs",
    "mockup:capture": "node docs/mockup/tools/capture.mjs"
  }
}

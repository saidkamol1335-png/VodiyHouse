{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vodiyhouse-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:site"],
      "port": 3000
    },
    {
      "name": "vodiyhouse-admin-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:admin"],
      "port": 3001
    },
    {
      "name": "mockup",
      "runtimeExecutable": "node",
      "runtimeArgs": ["docs/mockup/tools/serve.mjs"],
      "port": 4599
    },
    {
      "name": "vodiyhouse-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "-w", "@vh/site", "--", "--port", "3010"],
      "port": 3010
    }
  ]
}

# Кабинет admin.vodiyhouse.uz (PLAN §10). Скопируйте в apps/admin/.env.local и заполните.
# В настройках Netlify — у сайта админки свои переменные, не общие с сайтом vodiyhouse.uz.

# Supabase — тот же проект, что у сайта.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Секретный ключ (sb_secret_…) — ТОЛЬКО здесь: у сайта его нет (PLAN §10, п. 5).
SUPABASE_SECRET_KEY=
# Прямое подключение к базе — команды разработчика (миграции, DEMO, курс ЦБ).
SUPABASE_DB_URL=

# Адреса: ссылки из Telegram ведут в кабинет, сброс кэша и предпросмотр — на сайт.
# Локально: ADMIN_URL=http://localhost:3001, SITE_URL=http://localhost:3002.
ADMIN_URL=https://admin.vodiyhouse.uz
SITE_URL=https://vodiyhouse.uz
# Метка браузера сотрудника для сайта (vh-staff — его визиты не в статистике, фаза F, п. 40): общий
# домен кабинета и сайта. Только на боевых доменах; на *.netlify.app и локально — пусто.
STAFF_COOKIE_DOMAIN=.vodiyhouse.uz
# Подпись POST /api/revalidate сайта (HMAC, ≥ 32 символа) — тот же секрет в env сайта.
REVALIDATE_SECRET=
# Вебхук новой заявки (pg_net → /api/hooks/lead) — тот же секрет в Vault: lead_hook_secret.
# Адрес вебхука — в Vault: lead_hook_url (https://<кабинет>/api/hooks/lead).
LEAD_HOOK_SECRET=

# Server Actions на нескольких экземплярах Netlify — свой ключ, не тот, что у сайта.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Telegram: заявки, тревоги, запросы на публикацию. Вебхук бота — npm run bot:webhook -w @vh/admin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEADS_CHAT_ID=
# TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Вне боевой сборки (next dev, тесты) Telegram молчит. TELEGRAM_LIVE=1 — включить локально (проверка
# бота и кода входа руководителя), в .env.local надолго не оставлять: e2e подхватят этот сервер.
# TELEGRAM_DRY_RUN=1 — заглушить и `next start` для приёмки e2e. На сайтах Netlify не задавать.
# TELEGRAM_LIVE=
# TELEGRAM_DRY_RUN=
# Google Таблица заявок (docs/leads-sheet.md).
LEADS_SHEET_URL=
LEADS_SHEET_SECRET=
# Расписание /api/cron/* (Netlify Scheduled Function кабинета).
CRON_SECRET=

# CAPTCHA входа (Cloudflare Turnstile): ключ сайта, публичный.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Подсказка лимита видео отчёта в форме, МБ (фаза E; сам лимит — на бакете incoming, 50 МБ на бесплатном Supabase)
# NEXT_PUBLIC_VIDEO_MAX_MB=50

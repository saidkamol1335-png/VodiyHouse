# Кабинет admin.vodiyhouse.uz (PLAN §10). Скопируйте в apps/admin/.env.local и заполните.
# В настройках Netlify — у сайта админки свои переменные, не общие с сайтом vodiyhouse.uz.
# Фаза A — каркас: пока читаются только NEXT_PUBLIC_SUPABASE_URL (CSP). Остальное включается
# по фазам B–E; список — целевой, чтобы переезд env был виден заранее.

# Supabase — тот же проект, что у сайта.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Секретный ключ (sb_secret_…) — ТОЛЬКО здесь: у сайта его нет (PLAN §10, п. 5).
SUPABASE_SECRET_KEY=
# Прямое подключение к базе — команды разработчика (миграции, DEMO, курс ЦБ).
SUPABASE_DB_URL=

# Адреса: ссылки из Telegram ведут в кабинет, revalidate и предпросмотр — на сайт.
# ADMIN_URL=https://admin.vodiyhouse.uz
# SITE_URL=https://vodiyhouse.uz
# Подпись вебхука revalidate сайта (HMAC) — тот же секрет в env сайта (фаза C).
# REVALIDATE_SECRET=
# Подпись ссылки предпросмотра /preview/zhk/{slug}?token= (15 минут) — тот же секрет в env сайта.
# PREVIEW_SECRET=
# Database Webhook Supabase на новую заявку → /api/hooks/lead (фаза D).
# LEAD_HOOK_SECRET=

# Server Actions на нескольких экземплярах Netlify — свой ключ, не тот, что у сайта.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Telegram: заявки, тревоги, запросы на публикацию, код входа руководителя (фаза D).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_LEADS_CHAT_ID=
# TELEGRAM_ALERT_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=
# Google Таблица заявок (docs/leads-sheet.md).
# LEADS_SHEET_URL=
# LEADS_SHEET_SECRET=
# Расписание /api/cron/* (Netlify Scheduled Function админки).
# CRON_SECRET=

# CAPTCHA входа (Cloudflare Turnstile): ключ сайта, публичный.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

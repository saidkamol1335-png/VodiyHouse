# Сайт vodiyhouse.uz (PLAN §10). Скопируйте в apps/site/.env.local и заполните; .env.local в git не
# попадает. В Netlify — переменные сайта vodiyhouse-test / боевого сайта, не общие с админкой.
# Секретного ключа Supabase (sb_secret_…) у сайта НЕТ и быть не должно: читает сайт ролью посетителя
# (функции site_* и представления), пишет — подписанными функциями (SITE_SIGNING_SECRET ниже).

# Адрес проекта: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Публичный ключ (sb_publishable_…) — уходит в браузер, права ограничены функциями сайта.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Подпись записей сайта (PLAN §10, п. 5): заявки, «Написать в Telegram» и события идут в базу с
# HMAC-подписью этим секретом. Тот же секрет — в Supabase Vault под именем site_signing_secret
# (select vault.create_secret('…', 'site_signing_secret')). Без него сайт заявок не принимает.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SITE_SIGNING_SECRET=

# Сброс кэша сайта из админки: POST /api/revalidate с HMAC-подписью этим секретом. Тот же секрет —
# в env админки (REVALIDATE_SECRET). Без него сайт сброс не принимает (503) и обновляется по истечении кэша.
REVALIDATE_SECRET=

# Только для e2e (tests/e2e: DEMO-данные заводятся прямым подключением к тестовой базе). На Netlify —
# не задавать. Supabase → Connect → Session pooler (IPv4).
SUPABASE_DB_URL=

# Деплой (Netlify): на Netlify несколько экземпляров — общий ключ шифрования Server Actions.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Тестовый деплой (решение фазы 3, Ф2): 1 — noindex на всех ответах и robots.txt «Disallow: /».
# На боевом домене не задавать.
# SITE_NOINDEX=1
# Адрес сайта для canonical, hreflang и картинок превью — вшивается при сборке. На боевом сайте
# обязателен (https://vodiyhouse.uz): URL Netlify может быть ещё *.netlify.app. Без него — URL Netlify.
# SITE_URL=https://vodiyhouse.uz

# Рекламные пиксели (шаг 3.12): ID заказчика — на «Запуске». Пусто — скрипты не грузятся вовсе.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# Карта ЖК — Яндекс Static API (раздел «Расположение»). Пусто — своя заглушка вместо картинки.
# Ключ ПУБЛИЧНЫЙ: виден в адресе картинки любому посетителю — в кабинете разработчика Яндекса
# ограничить его по HTTP Referer (vodiyhouse.uz и тестовый деплой).
NEXT_PUBLIC_YANDEX_MAPS_KEY=

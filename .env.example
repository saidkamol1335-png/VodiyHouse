# Скопируйте в .env.local и заполните. .env.local в git не попадает.
# Supabase → Project Settings → API Keys: новые ключи sb_publishable_… / sb_secret_….
# Проверить заполнение и настройки проекта: npm run cloud:check (значения не печатает).

# Адрес проекта: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Публичный ключ — уходит в браузер, права ограничены RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Секретный ключ — только сервер, обходит RLS. Никогда не с префиксом NEXT_PUBLIC_.
# Только новый sb_secret_…: со старым service_role Auth не принимает IP посетителя, и лимиты
# входа считались бы на IP сервера — один на всех сотрудников (lib/supabase/authForwarding.ts).
SUPABASE_SECRET_KEY=

# Прямое подключение к базе — только для команд разработчика (npm run demo:seed / demo:remove,
# тесты базы против облака). Supabase → Connect → Session pooler (работает по IPv4):
# postgresql://postgres.<project-ref>:<пароль базы>@<регион>.pooler.supabase.com:5432/postgres
# Пароль базы — кнопкой Generate (буквы и цифры). Свой со знаками # % / ? : @ ломает адрес:
# такой пароль — через encodeURIComponent, а всё значение — в двойных кавычках.
# TLS включается сам (lib/supabase/dbClient.ts). sslmode в адрес не дописывать: require в pg
# значит полную проверку и без сертификата Supabase падает. Полная проверка — так:
# …/postgres?sslmode=verify-full&sslrootcert=supabase/prod-ca-2021.crt (Database → Settings → SSL).
SUPABASE_DB_URL=

# e2e против облака создают и удаляют тестовых сотрудников (e2e-…@example.com) — только в проекте
# с этим ref (часть адреса до .supabase.co). Без совпадения тесты падают, а не трогают чужой проект.
E2E_SUPABASE_PROJECT_REF=

# Деплой (Netlify): на Netlify несколько экземпляров — общий ключ шифрования Server Actions.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Тестовый деплой (решение фазы 3, Ф2): 1 — noindex на всех ответах и robots.txt «Disallow: /».
# На боевом домене не задавать.
# SITE_NOINDEX=1
# Адрес сайта для canonical, hreflang и картинок превью — вшивается при сборке. На боевом сайте
# обязателен (https://vodiyhouse.uz): URL Netlify может быть ещё *.netlify.app. Без него — URL Netlify.
# SITE_URL=https://vodiyhouse.uz
# Только локально: токен Netlify для `netlify deploy` (User settings → Applications → Personal
# access tokens). В настройки сайта Netlify не переносить.
# NETLIFY_AUTH_TOKEN=

# Заявки (шаг 3.7, ТЗ 10.4). Без значений канал выключен: заявка сохраняется в кабинете
# («Заявки»), в Telegram и Таблицу не уходит. Секреты — только здесь и в настройках Netlify.
# Бот: @BotFather → /newbot. Номер чата менеджеров (вида -100…) — бот в группе, /start в ней.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_LEADS_CHAT_ID=
# Тревога «заявка не дошла за 10 минут» — чат руководителя; пусто — в чат менеджеров.
# TELEGRAM_ALERT_CHAT_ID=
# Бот «Написать в Telegram» (шаг 3.8): тот же бот; имя бота — «Настройки → Контакты». Секрет
# вебхука — от 16 знаков (буквы, цифры, _ и -); адрес ставит `npm run bot:webhook` (нужен SITE_URL https).
# TELEGRAM_WEBHOOK_SECRET=
# Google Таблица: приёмник Apps Script в таблице (docs/leads-sheet.md) — адрес веб-приложения
# (https://script.google.com/macros/s/…/exec) и общий секрет (любая строка от 24 знаков).
# LEADS_SHEET_URL=
# LEADS_SHEET_SECRET=
# Расписание /api/cron/* (Netlify Scheduled Function): секрет от 16 знаков, тот же — в Netlify.
# CRON_SECRET=
# Дальше по фазам (TODO-заказчик): Meta Pixel, GA4.
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_GA4_ID=

# Рекламные пиксели (шаг 3.12): ID заказчика — на «Запуске». Пусто — скрипты не грузятся вовсе.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# Карта ЖК — Яндекс Static API (раздел «Расположение»). Пусто — своя заглушка вместо картинки.
# Ключ ПУБЛИЧНЫЙ: виден в адресе картинки любому посетителю. В кабинете разработчика Яндекса
# ограничить его по HTTP Referer (vodiyhouse.uz и тестовый деплой), иначе чужие сайты потратят
# квоту заказчика. Тот же ключ — в настройках Netlify (TODO-заказчик, «Запуск»).
NEXT_PUBLIC_YANDEX_MAPS_KEY=

# Скопируйте в .env.local и заполните. .env.local в git не попадает.
# Supabase → Project Settings → API Keys. Подходят новые ключи (sb_publishable_… / sb_secret_…)
# и старые (anon / service_role).

# Адрес проекта: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Публичный ключ — уходит в браузер, права ограничены RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Секретный ключ — только сервер, обходит RLS. Никогда не с префиксом NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Дальше по фазам (TODO-заказчик): Telegram-бот заявок, Google Таблица, Meta Pixel, GA4.
# TELEGRAM_BOT_TOKEN=
